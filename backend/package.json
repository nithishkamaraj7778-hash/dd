{
  "name": "finance-management-backend",
  "version": "1.0.0",
  "description": "Backend API server for Finance Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema ../prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --schema ../prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "test": "node test/run.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "prisma": "^5.12.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  }
}
